   "owner": "Program lead",
   "subsystems": [],
   "decision": "Hold 15 kg as program mass reserve. Only the program lead can release it.",
   "why": [
    "Late findings almost always add mass",
    "A named reserve stops each team padding its own number"
   ],
   "reopenIf": {
    "text": "Two subsystems ask for reserve in the same month",
    "never": true
   }
  },
  {
   "id": "D-02",
   "week": 3,
   "status": "made",
   "owner": "Supply chain lead",
   "subsystems": [
    "PWR"
   ],
   "decision": "Buy solar cells from one qualified supplier. No second source on this program.",
   "why": [
    "Qualifying a second source adds about 10 weeks",
    "The supplier has delivered on time twice before"
   ],
   "rejected": "Qualify a second source now",
   "reopenIf": {
